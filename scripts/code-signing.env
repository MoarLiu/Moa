# Shared by app builds and DMG packaging. Keep using the existing identity;
# never silently fall back to ad-hoc signing or recreate a missing certificate.
: "${CODE_SIGN_IDENTITY:=${MOA_CODE_SIGN_IDENTITY:-Moa Local Development Code Signing}}"

moa_resolve_signing_identity() {
  MOA_RESOLVED_SIGN_IDENTITY="-"
  MOA_SIGN_TIMESTAMP="--timestamp=none"
  MOA_SIGN_IS_DEVELOPER_ID=0
  if [[ "$CODE_SIGN_IDENTITY" == "-" ]]; then return; fi

  local fingerprint name count=0
  while read -r fingerprint name; do
    if [[ "$name" == "$CODE_SIGN_IDENTITY" || "$fingerprint" == "$CODE_SIGN_IDENTITY" ]]; then
      count=$((count + 1))
      MOA_RESOLVED_SIGN_IDENTITY="$fingerprint"
      if [[ "$name" == "Developer ID Application: "* ]]; then
        MOA_SIGN_TIMESTAMP="--timestamp"
        MOA_SIGN_IS_DEVELOPER_ID=1
      fi
    fi
  done < <(/usr/bin/security find-identity -v -p codesigning | sed -nE 's/^[[:space:]]*[0-9]+\) ([[:xdigit:]]{40}) "(.*)"$/\1 \2/p')

  if [[ "$count" != "1" ]]; then
    if [[ "$count" == "0" ]]; then
      echo "Missing code signing identity: $CODE_SIGN_IDENTITY" >&2
      echo "Restore the existing certificate and private key, or run ./scripts/setup-local-code-signing.sh for a first-time setup. CODE_SIGN_IDENTITY=- explicitly selects ad-hoc signing." >&2
    else
      echo "Ambiguous code signing identity: $CODE_SIGN_IDENTITY. Select its certificate fingerprint explicitly." >&2
    fi
    return 1
  fi
}

moa_codesign() {
  local target="$1"
  shift
  /usr/bin/codesign --force "$MOA_SIGN_TIMESTAMP" --sign "$MOA_RESOLVED_SIGN_IDENTITY" "$@" "$target"
}
