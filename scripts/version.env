: "${APP_VERSION:=1.6.3}"
: "${APP_BUILD:=129}"
: "${APP_RELEASE_VERSION:=1.6.3}"
: "${APP_ARCH:=$(uname -m)}"
: "${MACOS_DEPLOYMENT_TARGET:=12.0}"
: "${SWIFTC_TARGET:=${APP_ARCH}-apple-macosx${MACOS_DEPLOYMENT_TARGET}}"

moa_host_arch() {
  uname -m
}

# Native builds update the app that this Mac launches. Cross-architecture
# builds stay beside it so an Intel-only bundle cannot replace Moa.app and
# trigger the macOS 28 Rosetta warning on Apple silicon.
moa_app_output_path() {
  local root="$1"
  if [[ "${APP_ARCH}" == "$(moa_host_arch)" ]]; then
    printf '%s\n' "$root/Moa.app"
  else
    printf '%s\n' "$root/build/macos-${APP_ARCH}/Moa.app"
  fi
}

moa_assert_thin_macho() {
  local executable="$1"
  local expected="$2"
  local archs
  archs="$(/usr/bin/lipo -archs "$executable" 2>/dev/null || true)"
  if [[ "$archs" != "$expected" ]]; then
    echo "Mach-O architecture mismatch in $executable: expected thin $expected, found ${archs:-unknown}" >&2
    exit 1
  fi
}

moa_assert_bundle_arch() {
  local app="$1"
  local expected="$2"
  local found=0
  local candidate
  while IFS= read -r -d '' candidate; do
    local kind
    kind="$(/usr/bin/file -b "$candidate" 2>/dev/null || true)"
    if [[ "$kind" == *Mach-O* ]]; then
      moa_assert_thin_macho "$candidate" "$expected"
      found=$((found + 1))
    fi
  done < <(find "$app" -type f -print0)
  if [[ "$found" -lt 1 ]]; then
    echo "Expected at least one Mach-O in $app" >&2
    exit 1
  fi
}
